// Secrets.swift.example
//
// Copy this file to `Secrets.swift` in the same folder and fill in your
// own TMDB API key. `Secrets.swift` is gitignored so your key is never
// committed to source control.
//
//   cp Secrets.swift.example Secrets.swift
//
// Get a free API key at: https://www.themoviedb.org/settings/api

enum Secrets {
    static let tmdbAPIKey = "YOUR_TMDB_API_KEY"
    static let tmdbBaseURL = "https://api.themoviedb.org/3"
    static let tmdbImageBaseURL = "https://image.tmdb.org/t/p"
}
